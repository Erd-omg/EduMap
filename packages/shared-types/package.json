{
  "name": "@edumap/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript type definitions for EduMap",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./profile": {
      "import": "./src/profile.ts",
      "types": "./src/profile.ts"
    },
    "./knowledge-graph": {
      "import": "./src/knowledge-graph.ts",
      "types": "./src/knowledge-graph.ts"
    },
    "./resource": {
      "import": "./src/resource.ts",
      "types": "./src/resource.ts"
    },
    "./assessment": {
      "import": "./src/assessment.ts",
      "types": "./src/assessment.ts"
    },
    "./agent": {
      "import": "./src/agent.ts",
      "types": "./src/agent.ts"
    }
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
