# EduMap — Environment Configuration
# Copy to .env and fill in your values

# ─── LLM Configuration ──────────────────────────────────────────
# Default: iFlytek Spark (讯飞星火). Swap to any OpenAI-compatible API.
LLM_API_KEY=
LLM_API_BASE=https://spark-api.xf-yun.com/v3.5/chat
LLM_MODEL=spark

# ─── Database URLs ──────────────────────────────────────────────
# These are the default Docker Compose values.
# For local (non-Docker) development, change hosts to localhost.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=edumap_dev
CHROMA_HOST=localhost
CHROMA_PORT=8000
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://edumap:edumap_dev@localhost:5432/edumap

# ─── Feature Flags ──────────────────────────────────────────────
LOG_LEVEL=DEBUG
ENABLE_CELERY=true
