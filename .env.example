# EduMap — Environment Configuration
# Copy to .env and fill in your values

# ─── LLM Configuration ──────────────────────────────────────────
# Default: DeepSeek (OpenAI-compatible).
# Get a free API key at https://platform.deepseek.com/
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ─── API Security Key (optional) ────────────────────────────────
# If set, all API requests must include Authorization: Bearer <api_key>.
# Leave empty for open access during development.
API_KEY=

# ─── Database URLs ──────────────────────────────────────────────
# These are the default Docker Compose values.
# For local (non-Docker) development, change hosts to localhost.
#
# ⚠️ Service startup order (Docker Compose handles this automatically):
#    1. PostgreSQL → 2. Neo4j / Redis / ChromaDB → 3. Backend services
#    Handled via depends_on + healthcheck conditions in docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=edumap_dev
CHROMA_HOST=localhost
# CHROMA_PORT=8000 inside Docker network (mapped to 8003 on host)
CHROMA_PORT=8000
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://edumap:edumap_dev@localhost:5432/edumap

LOG_LEVEL=DEBUG

# ─── Frontend Configuration ──────────────────────────────────────────
# Used by the Next.js frontend at build time
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_PROFILE_BASE=http://localhost:8001
